# ============================================================
# ServiceNow AI Platform
# Environment Configuration Template
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=ServiceNow AI Platform
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# ------------------------------------------------------------
# API
# ------------------------------------------------------------

API_V1_PREFIX=/api/v1

# ------------------------------------------------------------
# AI Provider
# ------------------------------------------------------------

DEFAULT_AI_PROVIDER=gemini

# ------------------------------------------------------------
# Gemini
# ------------------------------------------------------------

GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ------------------------------------------------------------
# Ollama
# ------------------------------------------------------------

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------
# ServiceNow
# ------------------------------------------------------------

SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_password

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

LOG_LEVEL=INFO

# ------------------------------------------------------------
# HTTP
# ------------------------------------------------------------

HTTP_TIMEOUT=30

# ------------------------------------------------------------
# ServiceNow
# ------------------------------------------------------------

SERVICENOW_TABLE=incident

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=servicenow_ai_platform
DB_USERNAME=postgres
DB_PASSWORD=your_password

DB_ECHO=False

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ============================================================
# Security
# ============================================================

ACCESS_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
REFRESH_TOKEN_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Webhook Security
# ============================================================

WEBHOOK_API_KEY=your_very_long_random_api_key_here

# ============================================================
# Email Configuration
# ============================================================

EMAIL_PROVIDER=resend

RESEND_API_KEY=your_resend_api_key

EMAIL_FROM_NAME=ServiceNow AI Platform

# Development / Resend testing
# Use Resend's testing sender while EMAIL_TEST_MODE=true.
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# In test mode, all emails are redirected to this verified
# Resend testing recipient.
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=your_resend_registered_email@example.com

# ------------------------------------------------------------
# Production Email Configuration
# ------------------------------------------------------------
# After verifying your personal domain in Resend:
#
# EMAIL_TEST_MODE=false
# EMAIL_TEST_RECIPIENT=
# EMAIL_FROM_ADDRESS=no-reply@yourdomain.com
#
# No application code changes are required for multi-user
# email delivery. Emails will be sent to each user's
# registered email address automatically.