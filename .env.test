# -----------------------------
# Application
# -----------------------------

APP_NAME=ServiceNow AI Platform
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# -----------------------------
# API
# -----------------------------

API_V1_PREFIX=/api/v1

# -----------------------------
# Gemini
# -----------------------------

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# -----------------------------
# Ollama
# -----------------------------

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# -----------------------------
# ServiceNow
# -----------------------------

SERVICENOW_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# -----------------------------
# Logging
# -----------------------------

LOG_LEVEL=INFO

# -----------------------------
# HTTP
# -----------------------------

HTTP_TIMEOUT=30

# -------------------------------------------------
# AI
# -------------------------------------------------

DEFAULT_AI_PROVIDER=gemini

# ------------------------------------------------------------
# ServiceNow
# ------------------------------------------------------------

SERVICENOW_TABLE=incident
# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=servicenow_ai_platform_test
DB_USERNAME=postgres
DB_PASSWORD=2004
DB_ECHO=False

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800


# ============================================================
# Security
# ============================================================

ACCESS_TOKEN_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
REFRESH_TOKEN_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

REFRESH_TOKEN_EXPIRE_DAYS=7